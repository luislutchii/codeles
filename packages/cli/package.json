{
  "name": "codeles",
  "version": "1.0.0",
  "description": "CodeLES - AI Coding Agent with 1M Context (Nemotron 3 Ultra). Zero-config CLI with multi-provider support, built-in tools, memory, delegation, and cron.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codeles": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./commands": "./dist/commands/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "nemotron",
    "openrouter",
    "typescript",
    "developer-tools"
  ],
  "author": "Luís Lutchi <luis@lutchi.vercel.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luislutchii/codeles.git"
  },
  "homepage": "https://codeles-landing.vercel.app",
  "bugs": {
    "url": "https://github.com/luislutchii/codeles/issues"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@codeles/core": "1.0.0",
    "@codeles/providers": "1.0.0",
    "@codeles/tools": "1.0.0",
    "boxen": "^7.1.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "ink": "^4.4.0",
    "ink-big-text": "^1.2.0",
    "ink-gradient": "^2.0.0",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.0.0",
    "ink-text-input": "^5.0.0",
    "ora": "^8.0.0",
    "react": "^18.2.0",
    "uuid": "^9.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}