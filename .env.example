# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (access to 100+ models)
# OPENROUTER_API_KEY=sk-or-...

# Google (Gemini)
# GOOGLE_API_KEY=...

# Cohere
# COHERE_API_KEY=...

# Mistral
# MISTRAL_API_KEY=...

# Groq (ultra-fast inference)
# GROQ_API_KEY=gsk_...

# Together AI
# TOGETHER_API_KEY=...

# Custom OpenAI-compatible provider
# CUSTOM_PROVIDER_API_KEY=...
# CUSTOM_PROVIDER_BASE_URL=https://your-api.com/v1
# CUSTOM_PROVIDER_MODEL=your-model-name

# ==========================================
# CodeLES Settings
# ==========================================
# CODELES_DEFAULT_PROVIDER=nvidia
# CODELES_DEFAULT_MODEL=nvidia/nemotron-3-ultra
# CODELES_THEME=dark
# CODELES_LANGUAGE=pt-BR
# CODELES_COMPACT_MODE=false
# CODELES_WORKDIR=.
# CODELES_MEMORY_PATH=~/.codeles/memory